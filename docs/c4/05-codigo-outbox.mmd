C4Component
  title video-service - Fluxo da Outbox Transacional (nivel de codigo)

  Component(controller, "VideoController", "REST", "Recebe multipart.")
  Component(app, "VideoApplicationServiceImpl", "Application", "upload() executa em @Transactional.")
  Component(repoVideo, "VideoRepository", "JPA", "Grava video.")
  Component(repoOutbox, "OutboxEventoRepository", "JPA", "Grava outbox_evento.")
  ComponentDb(db, "PostgreSQL", "fiapx_video", "Commit atomico de video + outbox.")
  Component(publisher, "OutboxPublisher", "Scheduler a cada 2s", "Le PENDENTE, publica e marca ENVIADO.")
  ContainerQueue(kafka, "Kafka", "fiapx.video.solicitado", "Evento VideoSolicitado.")
  Component(consumer, "VideoEventoConsumer", "Kafka Listener", "Consome resultado idempotente.")
  Component(repoEvento, "EventoProcessadoRepository", "JPA", "Garante exactly-once logico.")

  Rel(controller, app, "upload(usuario, email, arquivo)")
  Rel(app, repoVideo, "save(video)")
  Rel(app, repoOutbox, "save(evento PENDENTE)")
  Rel(repoVideo, db, "INSERT")
  Rel(repoOutbox, db, "INSERT na mesma transacao")
  Rel(publisher, repoOutbox, "findTop50ByStatus(PENDENTE)")
  Rel(publisher, kafka, "send(topico, aggregateId, payload)")
  Rel(publisher, repoOutbox, "marcarEnviado()")
  Rel(kafka, consumer, "VideoProcessado / VideoFalha")
  Rel(consumer, repoEvento, "existsById(eventId)")
  Rel(consumer, app, "registrarProcessamentoConcluido / registrarFalha")
