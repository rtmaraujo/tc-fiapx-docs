C4Component
  title video-service - Diagrama de Componentes

  Container_Boundary(video, "video-service") {
    Component(controller, "VideoController", "Spring MVC", "Upload multipart, listagem, consulta e download em streaming.")
    Component(security, "SecurityConfig + JwtAuthenticationFilter", "Spring Security", "Autentica Bearer JWT e extrai UsuarioPrincipal.")
    Component(app, "VideoApplicationServiceImpl", "Application Service", "Regras de upload, status, download e notificacao.")
    Component(domain, "Video", "Domain", "Agregado com transicoes PENDENTE -> PROCESSANDO -> CONCLUIDO/ERRO.")
    Component(outbox, "OutboxPublisher", "Scheduler", "Publica eventos pendentes no Kafka e controla tentativas.")
    Component(consumer, "VideoEventoConsumer", "Spring Kafka", "Consome processado/falha com idempotencia por eventId.")
    Component(notifier, "NotificacaoScheduler", "Scheduler", "Envia e-mails pendentes com retentativa.")
    Component(storage, "MinioStorageAdapter", "Adapter S3", "Implementa StoragePort com o cliente MinIO (compativel com S3).")
    Component(email, "SmtpEmailAdapter", "Adapter SMTP", "Implementa EmailPort sobre JavaMail.")
    Component(handler, "GlobalExceptionHandler", "Spring MVC", "Respostas de erro 400/404/409/502/500.")
  }

  ContainerDb(db, "PostgreSQL", "fiapx_video", "video, outbox_evento, evento_processado, notificacao.")
  ContainerQueue(kafka, "Kafka", "Mensageria", "Topicos de solicitacao, conclusao e falha.")
  ContainerDb(s3, "SeaweedFS (S3)", "Object storage", "Bucket fiapx-videos.")
  Container(smtp, "SMTP", "MailHog / servidor real", "Envio de e-mail.")

  Rel(controller, security, "Requisicao autenticada")
  Rel(controller, app, "Casos de uso")
  Rel(app, domain, "Aplica transicoes")
  Rel(app, storage, "Salva original e le ZIP")
  Rel(app, outbox, "Grava evento na mesma transacao", "JDBC")
  Rel(outbox, kafka, "Publica VideoSolicitado")
  Rel(kafka, consumer, "Entrega processado/falha")
  Rel(consumer, app, "Atualiza status")
  Rel(app, notifier, "Agenda notificacao de falha", "Tabela notificacao")
  Rel(notifier, email, "Envia e-mail")
  Rel(email, smtp, "SMTP")
  Rel(app, db, "Persiste agregado e outbox", "JDBC")
  Rel(storage, s3, "S3 API")
